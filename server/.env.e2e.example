# Environment for the black-box e2e suite (server/e2e-tests).
#
# The harness (e2e-tests/harness_test.go) reads these vars, applying the same
# defaults shown here, then builds + launches the server as a subprocess against
# a local file SQLite DB and dockerized MinIO. You normally don't need to set
# anything: `make test-e2e` exports these defaults and boots MinIO for you.
#
# Bring MinIO up first:  docker compose up -d minio createbuckets

# Where the harness reaches the server it launches. PORT is passed to the child.
PORT=8080
# E2E_BASE_URL=http://localhost:8080   # override to test an already-running server (skips launching one)

# Local file SQLite DB (fresh temp file per run by default).
DATABASE_URL=file:./tmp/railway-e2e.db

# Management auth (OAuth/OIDC) is handled by the harness itself: it self-hosts an
# OIDC provider (discovery + JWKS), points the launched server at it via
# OAUTH_ISSUER, and mints its own admin access token — so nothing to set here.
#
# When targeting an already-running server (E2E_BASE_URL), supply a valid admin
# access token instead:
# E2E_BEARER_TOKEN=

# MinIO (S3-compatible) — must match docker-compose.yaml.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=railway-wiki
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/railway-wiki
S3_PRESIGN_TTL=15m
