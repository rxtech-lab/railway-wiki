// Copy this file to Secrets.Debug.xcconfig and Secrets.Release.xcconfig.
// Both files are ignored by Git. The iOS key must be accepted only by /maps/.
RAILWAY_API_BASE_URL = https:/$()/railway-api.example.com
OVERPASS_API_BASE_URL = https:/$()/railway-api.example.com/api/management/overpass
OSM_STACK_BASE_URL = https:/$()/maps.example.com
OSM_MAPS_API_KEY = REPLACE_WITH_IOS_MAPS_ONLY_KEY
AUTH_CLIENT_ID = REPLACE_WITH_OAUTH_CLIENT_ID
