# Server
PORT=8080

# Database (TursoDB / libSQL)
# Remote Turso:   libsql://<db>-<org>.turso.io?authToken=<token>
# Local SQLite:   file:railway.db   (default)   or   :memory:
DATABASE_URL=file:railway.db

# Management authentication (OAuth/OIDC)
# Management endpoints require a JWT access token whose `role` claim is `admin`.
# The JWKS endpoint is discovered from the issuer via OIDC discovery
# (OAUTH_ISSUER + /.well-known/openid-configuration), and the token `iss` is
# enforced against it.
OAUTH_ISSUER=https://issuer.example.com/

# Media object storage (S3-compatible). Leave S3_BUCKET empty to disable uploads.
# For local MinIO (docker compose up -d minio createbuckets):
#   S3_ENDPOINT=http://localhost:9000, S3_PATH_STYLE=true, creds minioadmin/minioadmin
#
# Cloudflare R2: use the ACCOUNT-level endpoint (do NOT put the bucket in it) and
# pass the bucket only via S3_BUCKET, or objects land at {bucket}/{bucket}/{key}.
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com   # no bucket here
#   S3_BUCKET=<your-bucket>
#   S3_REGION=auto
#   S3_PATH_STYLE=true
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY = R2 API token key/secret
#   S3_PUBLIC_URL=https://<public-bucket>.r2.dev   # or your custom domain
S3_BUCKET=
S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_URL=http://localhost:9000/railway-wiki
S3_PATH_STYLE=false
S3_PRESIGN_TTL=15m
